---
import HomeV1 from "./index-v1.astro";
import HomeV2 from "./index-v2.astro";
import { FliptClient } from "@flipt-io/flipt-client-js";

const client = await FliptClient.init({
	namespace: import.meta.env.FLIPT_NAMESPACE,
	url: import.meta.env.FLIPT_URL,
});

// note: compile time so need to redeploy if conditions change
const isLandingV2Enabled = client.evaluateBoolean({
	flagKey: "landing-v2",
	entityId: "default",
	context: {},
});
---

{isLandingV2Enabled.enabled && <HomeV2 />}

{!isLandingV2Enabled.enabled && <HomeV1 />}
